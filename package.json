{
  "name": "@local/jarvis-theme",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "J.A.R.V.I.S. HUD skin and arc-reactor boot sequence for the DSH web client.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "jarvis",
    "hud",
    "arc-reactor"
  ],
  "homepage": "https://github.com/best0127/dsh-jarvis-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/best0127/dsh-jarvis-theme.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "fonts/*"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}




